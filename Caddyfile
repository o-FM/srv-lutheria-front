# Caddy de produção: front + proxy da API no MESMO domínio (sem CORS).
#   DOMAIN      ex.: app.suaoficina.com.br (DNS apontando para o servidor)
#   ACME_EMAIL  e-mail para avisos do Let's Encrypt
#   API_UPSTREAM  padrão app:8080 (serviço do docker compose)
{
	email {$ACME_EMAIL}
	servers {
		# Só o Caddy fala com a internet; o X-Forwarded-For que chega à API é o do cliente
		trusted_proxies static private_ranges
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# API: /api/service-orders -> app:8080/service-orders
	handle_path /api/* {
		request_body {
			# Fotos da OS chegam em base64 (até ~4 MB)
			max_size 6MB
		}
		reverse_proxy {$API_UPSTREAM:app:8080} {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Front (SPA): rotas como /acompanhar/<token> e /redefinir-senha caem no index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Câmera (fotos/leitor) e microfone (ditado) liberados só para o próprio app
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format json
	}
}
