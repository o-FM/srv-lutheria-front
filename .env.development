# Desenvolvimento local: `npm run dev`, `npm run dev:vite` e `npm run dev:api` chamam o backend
# srv-lutheria direto nesta URL (o perfil dev da API já libera CORS para :3000 e :5173).
# Outra URL só na sua máquina: crie .env.development.local. Sem backend: `npm run dev:demo`.
VITE_API_URL=http://localhost:8080
